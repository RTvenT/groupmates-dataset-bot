BOT_TOKEN=123456:ABC-DEF
# ID папки на Google Drive, внутри которой бот работает. "root" = корень "Мой диск"
ROOT_FOLDER_ID=root
# Telegram user id через запятую. Пусто = доступ всем!
ALLOWED_USERS=
# Telegram id админов через запятую: им доступна /admin (удаление фото)
ADMIN_USERS=
# Прокси для Telegram API, если он недоступен напрямую (http:// или socks5://)
TELEGRAM_PROXY=
# Сторона квадрата, к которому приводятся фото (вход YOLO)
IMAGE_SIZE=640
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_TOKEN_FILE=token.json
